; Isolated technical fixture. Never a canonical AIVideoEdit production source.
config_version=5

[application]
config/name="AIVideoEdit - Godot Renderer Technical Test"
run/main_scene="res://scenes/proof_2d.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
